# Environment Configuration Example
# Copy this file to .env and fill in your actual API keys

# Base URL for API calls
BASE_URL=https://uatapi.ado-dad.com
# Release builds ignore BASE_URL here and call https://api.adodad.com, unless
# built with --dart-define=API_ENV=uat (testing APK) or --dart-define=BASE_URL=...

# Local backend on a physical phone (USB/Wi‑Fi debugging): your PC's Wi‑Fi IPv4.
# Example: DEV_HOST_IP=192.168.1.42 with BASE_URL=http://localhost:5000
# Leave empty when using the Android emulator only (uses 10.0.2.2 automatically).
# DEV_HOST_IP=192.168.1.42

# Google Places API Key for map integration
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Add other API keys here as needed
# EXAMPLE_API_KEY=your_api_key_here
